# TraceHarvest admin dashboard: environment variables (set these in Vercel -> Settings -> Environment Variables)

# Google Maps Platform key for the GIS satellite view. Create it in Google Cloud Console and RESTRICT it
# (HTTP referrers = your dashboard domain; API = Maps JavaScript API only). Never commit a real key.
# Leave empty to use the built-in offline map.
VITE_GOOGLE_MAPS_API_KEY=""

# Mobile Sync Simulator: keep "false" in production. It posts sample records to the live backend.
VITE_ENABLE_SIMULATOR="false"

# Optional: shows a "Request access" link on the sign-in page. Leave empty to hide the link.
VITE_ACCESS_REQUEST_EMAIL=""
