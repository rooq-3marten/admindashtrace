# Copy to backend/.env (never commit the real file) and fill in your own values.
# Make long random values, for example:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=

# Admin sign-in (Firebase)
FIREBASE_PROJECT_ID=
ADMIN_EMAILS=

# Turn these on once the matching apps send sign-in tokens
REQUIRE_ADMIN_AUTH=false
REQUIRE_AGENT_AUTH=false
